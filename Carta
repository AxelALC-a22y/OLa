    <style>
        /* Fondo con degradado azul animado y profundo */
        .blue-gradient-bg {
            background: linear-gradient(135deg, #0f172a, #1e3a8a, #3b82f6, #60a5fa);
            background-size: 300% 300%;
            animation: gradientAnimation 12s ease infinite;
        }

        @keyframes gradientAnimation {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Animación suave para los conejos flotantes */
        @keyframes floatRabbit {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(3deg); }
        }

        .floating-rabbit {
            animation: floatRabbit 4s ease-in-out infinite;
        }

        .floating-rabbit-delayed {
            animation: floatRabbit 5s ease-in-out infinite 2s;
        }
    </style>
</head>
